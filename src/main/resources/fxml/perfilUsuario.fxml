<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="420.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="consultorio.controller.PerfilUsuarioController">
   <children>
      <Label layoutX="30.0" layoutY="14.0" text="Mi Perfil">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>
      <Pane layoutX="30.0" layoutY="50.0" prefHeight="160.0" prefWidth="540.0" style="-fx-border-color: #cbd5e1; -fx-border-radius: 8; -fx-background-radius: 8;">
         <children>
            <Label layoutX="15.0" layoutY="10.0" text="Datos Personales y de Contacto">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </Label>
            <Label layoutX="15.0" layoutY="45.0" text="ID:" />
            <TextField fx:id="textFieldID" disable="true" editable="false" layoutX="90.0" layoutY="40.0" prefHeight="30.0" prefWidth="160.0" />
            <Label layoutX="280.0" layoutY="45.0" text="Usuario:" />
            <TextField fx:id="textFieldUsuario" disable="true" editable="false" layoutX="355.0" layoutY="40.0" prefHeight="30.0" prefWidth="165.0" />
            <Label layoutX="15.0" layoutY="85.0" text="Nombre:" />
            <TextField fx:id="textFieldNombre" layoutX="90.0" layoutY="80.0" prefHeight="30.0" prefWidth="430.0" promptText="Nombre completo" />
            <Label layoutX="15.0" layoutY="125.0" text="Teléfono:" />
            <TextField fx:id="textFieldTelefono" layoutX="90.0" layoutY="120.0" prefHeight="30.0" prefWidth="160.0" promptText="Teléfono" />
            <Label layoutX="280.0" layoutY="125.0" text="Correo:" />
            <TextField fx:id="textFieldCorreo" layoutX="355.0" layoutY="120.0" prefHeight="30.0" prefWidth="165.0" promptText="Correo electrónico" />
         </children>
      </Pane>
      <Button layoutX="430.0" layoutY="220.0" mnemonicParsing="false" onAction="#clicGuardarDatos" prefHeight="32.0" prefWidth="140.0" text="Guardar Datos" />
      <Pane layoutX="30.0" layoutY="265.0" prefHeight="105.0" prefWidth="540.0" style="-fx-border-color: #cbd5e1; -fx-border-radius: 8; -fx-background-radius: 8;">
         <children>
            <Label layoutX="15.0" layoutY="10.0" text="Cambiar Contraseña">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </Label>
            <Label layoutX="15.0" layoutY="40.0" text="Actual:" />
            <PasswordField fx:id="passwordFieldActual" layoutX="70.0" layoutY="35.0" prefHeight="30.0" prefWidth="100.0" promptText="Actual" />
            <Label layoutX="185.0" layoutY="40.0" text="Nueva:" />
            <PasswordField fx:id="passwordFieldNueva" layoutX="235.0" layoutY="35.0" prefHeight="30.0" prefWidth="110.0" promptText="Nueva" />
            <Label layoutX="360.0" layoutY="40.0" text="Confirmar:" />
            <PasswordField fx:id="passwordFieldConfirmar" layoutX="430.0" layoutY="35.0" prefHeight="30.0" prefWidth="95.0" promptText="Confirmar" />
         </children>
      </Pane>
      <Button layoutX="400.0" layoutY="380.0" mnemonicParsing="false" onAction="#clicCambiarContrasenia" prefHeight="32.0" prefWidth="170.0" text="Actualizar Contraseña" />
   </children>
</AnchorPane>

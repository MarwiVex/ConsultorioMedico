<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="450.0" prefWidth="760.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="consultorio.controller.asistente.GestionPacientesController">
   <children>
      <Label layoutX="25.0" layoutY="14.0" text="Gestión de Pacientes">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>
      <Label layoutX="25.0" layoutY="55.0" text="ID:" />
      <TextField fx:id="textFieldID" disable="true" editable="false" layoutX="120.0" layoutY="50.0" prefHeight="30.0" prefWidth="160.0" promptText="Automático" />
      <Label layoutX="25.0" layoutY="95.0" text="Nombre:" />
      <TextField fx:id="textFieldNombre" layoutX="120.0" layoutY="90.0" prefHeight="30.0" prefWidth="160.0" promptText="Nombre completo" />
      <Label layoutX="25.0" layoutY="135.0" text="F. Nacimiento:" />
      <DatePicker fx:id="datePickerFechaNacimiento" layoutX="120.0" layoutY="130.0" prefHeight="30.0" prefWidth="160.0" promptText="Fecha de nacimiento" />
      <Label layoutX="25.0" layoutY="175.0" text="Sexo:" />
      <ComboBox fx:id="comboBoxSexo" layoutX="120.0" layoutY="170.0" prefHeight="30.0" prefWidth="160.0" promptText="Sexo" />
      <Label layoutX="25.0" layoutY="215.0" text="Teléfono:" />
      <TextField fx:id="textFieldTelefono" layoutX="120.0" layoutY="210.0" prefHeight="30.0" prefWidth="160.0" promptText="Teléfono" />
      <Label layoutX="25.0" layoutY="255.0" text="Correo:" />
      <TextField fx:id="textFieldCorreo" layoutX="120.0" layoutY="250.0" prefHeight="30.0" prefWidth="160.0" promptText="Correo electrónico" />
      <Label layoutX="300.0" layoutY="18.0" text="Buscar:" />
      <TextField fx:id="textFieldBuscar" layoutX="350.0" layoutY="13.0" prefHeight="30.0" prefWidth="280.0" promptText="Buscar por nombre, teléfono o ID" />
      <Button layoutX="640.0" layoutY="13.0" mnemonicParsing="false" onAction="#clicBuscar" prefHeight="30.0" prefWidth="95.0" text="Buscar" />
      <TableView fx:id="tableViewPacientes" layoutX="300.0" layoutY="50.0" onMouseClicked="#clicTabla" prefHeight="320.0" prefWidth="435.0" />
      <ButtonBar layoutX="25.0" layoutY="385.0" prefHeight="40.0" prefWidth="710.0">
         <buttons>
            <Button mnemonicParsing="false" onAction="#clicAgregar" text="Agregar" />
            <Button mnemonicParsing="false" onAction="#clicModificar" text="Modificar" />
            <Button mnemonicParsing="false" onAction="#clicLimpiar" text="Limpiar" />
         </buttons>
      </ButtonBar>
   </children>
</AnchorPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="480.0" prefWidth="820.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="consultorio.controller.asistente.GestionCitasController">
   <children>
      <Label layoutX="25.0" layoutY="14.0" text="Gestión de Citas y Agenda">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>
      <Label layoutX="25.0" layoutY="55.0" text="ID:" />
      <TextField fx:id="textFieldID" disable="true" editable="false" layoutX="120.0" layoutY="50.0" prefHeight="30.0" prefWidth="160.0" promptText="Automático" />
      <Label layoutX="25.0" layoutY="95.0" text="Paciente:" />
      <ComboBox fx:id="comboBoxPaciente" layoutX="120.0" layoutY="90.0" prefHeight="30.0" prefWidth="160.0" promptText="Seleccionar paciente" />
      <Label layoutX="25.0" layoutY="135.0" text="Médico:" />
      <ComboBox fx:id="comboBoxMedico" layoutX="120.0" layoutY="130.0" prefHeight="30.0" prefWidth="160.0" promptText="Seleccionar médico" />
      <Label layoutX="25.0" layoutY="175.0" text="Fecha:" />
      <DatePicker fx:id="datePickerFecha" layoutX="120.0" layoutY="170.0" prefHeight="30.0" prefWidth="160.0" promptText="Fecha de la cita" />
      <Label layoutX="25.0" layoutY="215.0" text="Hora:" />
      <ComboBox fx:id="comboBoxHora" layoutX="120.0" layoutY="210.0" prefHeight="30.0" prefWidth="160.0" promptText="Hora" />
      <Label layoutX="25.0" layoutY="255.0" text="Estado:" />
      <ComboBox fx:id="comboBoxEstado" layoutX="120.0" layoutY="250.0" prefHeight="30.0" prefWidth="160.0" promptText="Estado" />
      <Label layoutX="25.0" layoutY="295.0" text="Observaciones:" />
      <TextField fx:id="textFieldObservaciones" layoutX="120.0" layoutY="290.0" prefHeight="30.0" prefWidth="160.0" promptText="Observaciones (opcional)" />
      <Label layoutX="305.0" layoutY="55.0" text="Fecha:" />
      <DatePicker fx:id="datePickerFiltroFecha" layoutX="355.0" layoutY="50.0" prefHeight="30.0" prefWidth="135.0" promptText="Fecha" />
      <ComboBox fx:id="comboBoxFiltroPeriodo" layoutX="500.0" layoutY="50.0" prefHeight="30.0" prefWidth="135.0" promptText="Día / Semana" />
      <ComboBox fx:id="comboBoxFiltroEstado" layoutX="645.0" layoutY="50.0" prefHeight="30.0" prefWidth="150.0" promptText="Estado" />
      <Label layoutX="305.0" layoutY="95.0" text="Buscar:" />
      <TextField fx:id="textFieldBuscarPaciente" layoutX="355.0" layoutY="90.0" prefHeight="30.0" prefWidth="240.0" promptText="Buscar paciente por nombre o ID" />
      <Button layoutX="605.0" layoutY="90.0" mnemonicParsing="false" onAction="#clicFiltrar" prefHeight="30.0" prefWidth="90.0" text="Filtrar" />
      <Button layoutX="705.0" layoutY="90.0" mnemonicParsing="false" onAction="#clicVerTodas" prefHeight="30.0" prefWidth="90.0" text="Ver Todas" />
      <TableView fx:id="tableViewCitas" layoutX="305.0" layoutY="130.0" onMouseClicked="#clicTabla" prefHeight="285.0" prefWidth="490.0" />
      <ButtonBar layoutX="25.0" layoutY="425.0" prefHeight="40.0" prefWidth="770.0">
         <buttons>
            <Button mnemonicParsing="false" onAction="#clicAgendar" text="Agendar" />
            <Button mnemonicParsing="false" onAction="#clicModificar" text="Modificar" />
            <Button mnemonicParsing="false" onAction="#clicRegistrarLlegada" text="Registrar Llegada" />
            <Button mnemonicParsing="false" onAction="#clicCancelar" text="Cancelar Cita" />
            <Button mnemonicParsing="false" onAction="#clicLimpiar" text="Limpiar" />
         </buttons>
      </ButtonBar>
   </children>
</AnchorPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="440.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="consultorio.controller.asistente.AsistenteController">
   <children>
      <Pane prefHeight="440.0" prefWidth="250.0" style="-fx-background-color: #1e293b;">
         <children>
            <Label layoutX="40.0" layoutY="26.0" text="Asistente" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="20.0" />
               </font>
            </Label>
            <Label layoutX="40.0" layoutY="56.0" text="Panel de Control" textFill="#94a3b8">
               <font>
                  <Font size="12.0" />
               </font>
            </Label>
            <Button layoutX="40.0" layoutY="100.0" mnemonicParsing="false" onAction="#clicPacientes" prefHeight="36.0" prefWidth="170.0" text="Pacientes" />
            <Button layoutX="40.0" layoutY="150.0" mnemonicParsing="false" onAction="#clicCitas" prefHeight="36.0" prefWidth="170.0" text="Citas y Agenda" />
            <Button layoutX="40.0" layoutY="200.0" mnemonicParsing="false" onAction="#clicPerfil" prefHeight="36.0" prefWidth="170.0" text="Mi Perfil" />
            <Button layoutX="40.0" layoutY="360.0" mnemonicParsing="false" onAction="#clickCerrarSesion" prefHeight="36.0" prefWidth="170.0" text="Cerrar Sesión" />
         </children>
      </Pane>
   </children>
</AnchorPane>

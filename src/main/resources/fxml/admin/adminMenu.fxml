<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="440.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="consultorio.controller.admin.AdminController">
   <children>
      <Pane prefHeight="440.0" prefWidth="250.0" style="-fx-background-color: #1e293b;">
         <children>
            <Label layoutX="40.0" layoutY="26.0" text="Administrador" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="20.0" />
               </font>
            </Label>
            <Label layoutX="40.0" layoutY="56.0" text="Panel de Control" textFill="#94a3b8">
               <font>
                  <Font size="12.0" />
               </font>
            </Label>
            <Button layoutX="40.0" layoutY="100.0" mnemonicParsing="false" onAction="#clicEspecialidades" prefHeight="36.0" prefWidth="170.0" text="Especialidades" />
            <Button layoutX="40.0" layoutY="150.0" mnemonicParsing="false" onAction="#clicMedicos" prefHeight="36.0" prefWidth="170.0" text="Médicos" />
            <Button layoutX="40.0" layoutY="200.0" mnemonicParsing="false" onAction="#clickAsistentes" prefHeight="36.0" prefWidth="170.0" text="Asistentes" />
            <Button layoutX="40.0" layoutY="250.0" mnemonicParsing="false" onAction="#clickReportes" prefHeight="36.0" prefWidth="170.0" text="Reportes" />
            <Button layoutX="40.0" layoutY="360.0" mnemonicParsing="false" onAction="#clickCerrarSesion" prefHeight="36.0" prefWidth="170.0" text="Cerrar Sesión" />
         </children>
      </Pane>
   </children>
</AnchorPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="440.0" prefWidth="740.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="consultorio.controller.admin.GestionEspecialidadesController">
   <children>
      <Label layoutX="25.0" layoutY="14.0" text="Gestión de Especialidades">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>
      <Label layoutX="25.0" layoutY="55.0" text="ID:" />
      <TextField fx:id="textFieldID" disable="true" editable="false" layoutX="115.0" layoutY="50.0" prefHeight="30.0" prefWidth="165.0" promptText="Automático" />
      <Label layoutX="25.0" layoutY="95.0" text="Nombre:" />
      <TextField fx:id="textFieldNombre" layoutX="115.0" layoutY="90.0" prefHeight="30.0" prefWidth="165.0" promptText="Nombre de la especialidad" />
      <Label layoutX="25.0" layoutY="135.0" text="Descripción:" />
      <TextField fx:id="textFieldDescripcion" layoutX="115.0" layoutY="130.0" prefHeight="30.0" prefWidth="165.0" promptText="Descripción" />
      <Label layoutX="25.0" layoutY="175.0" text="Estado:" />
      <ComboBox fx:id="comboBoxEstado" layoutX="115.0" layoutY="170.0" prefHeight="30.0" prefWidth="165.0" promptText="Estado" />
      <Label layoutX="25.0" layoutY="215.0" text="Médicos asociados a la especialidad:">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Label>
      <ListView fx:id="listViewMedicos" layoutX="25.0" layoutY="238.0" prefHeight="122.0" prefWidth="255.0" />
      <TableView fx:id="tableViewEspecialidades" layoutX="300.0" layoutY="50.0" onMouseClicked="#clicTabla" prefHeight="310.0" prefWidth="415.0" />
      <ButtonBar layoutX="25.0" layoutY="380.0" prefHeight="40.0" prefWidth="690.0">
         <buttons>
            <Button mnemonicParsing="false" onAction="#clicAgregar" text="Agregar" />
            <Button mnemonicParsing="false" onAction="#clicModificar" text="Modificar" />
            <Button mnemonicParsing="false" onAction="#clicActivarDesactivar" text="Activar/Desactivar" />
            <Button mnemonicParsing="false" onAction="#clicLimpiar" text="Limpiar" />
         </buttons>
      </ButtonBar>
   </children>
</AnchorPane>

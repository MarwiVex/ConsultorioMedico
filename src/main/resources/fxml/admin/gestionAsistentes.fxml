<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="430.0" prefWidth="740.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="consultorio.controller.admin.GestionAsistentesController">
   <children>
      <Label layoutX="25.0" layoutY="14.0" text="Gestión de Asistentes">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>
      <Label layoutX="25.0" layoutY="55.0" text="ID:" />
      <TextField fx:id="textFieldID" disable="true" editable="false" layoutX="120.0" layoutY="50.0" prefHeight="30.0" prefWidth="160.0" promptText="Automático" />
      <Label layoutX="25.0" layoutY="95.0" text="Nombre:" />
      <TextField fx:id="textFieldNombre" layoutX="120.0" layoutY="90.0" prefHeight="30.0" prefWidth="160.0" promptText="Nombre completo" />
      <Label layoutX="25.0" layoutY="135.0" text="Teléfono:" />
      <TextField fx:id="textFieldTelefono" layoutX="120.0" layoutY="130.0" prefHeight="30.0" prefWidth="160.0" promptText="Teléfono" />
      <Label layoutX="25.0" layoutY="175.0" text="Correo:" />
      <TextField fx:id="textFieldCorreo" layoutX="120.0" layoutY="170.0" prefHeight="30.0" prefWidth="160.0" promptText="Correo electrónico" />
      <Label layoutX="25.0" layoutY="215.0" text="Usuario:" />
      <TextField fx:id="textFieldUsuario" layoutX="120.0" layoutY="210.0" prefHeight="30.0" prefWidth="160.0" promptText="Usuario" />
      <Label layoutX="25.0" layoutY="255.0" text="Contraseña:" />
      <PasswordField fx:id="textFieldContrasenia" layoutX="120.0" layoutY="250.0" prefHeight="30.0" prefWidth="160.0" promptText="Contraseña" />
      <Label layoutX="25.0" layoutY="295.0" text="Estado:" />
      <ComboBox fx:id="comboBoxEstado" layoutX="120.0" layoutY="290.0" prefHeight="30.0" prefWidth="160.0" promptText="Estado" />
      <TableView fx:id="tableViewAsistentes" layoutX="300.0" layoutY="50.0" onMouseClicked="#clicTabla" prefHeight="280.0" prefWidth="415.0" />
      <ButtonBar layoutX="25.0" layoutY="360.0" prefHeight="40.0" prefWidth="690.0">
         <buttons>
            <Button mnemonicParsing="false" onAction="#clicAgregar" text="Agregar" />
            <Button mnemonicParsing="false" onAction="#clicActivarDesactivar" text="Activar/Desactivar" />
            <Button mnemonicParsing="false" onAction="#clicLimpiar" text="Limpiar" />
         </buttons>
      </ButtonBar>
   </children>
</AnchorPane>
